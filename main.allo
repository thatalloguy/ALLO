print hello;

var condition = false;
if (condition) {
    print("Condition was true");
}
else {
    print("Condition was false");
}

var integer = 0;
while (integer < 10) {
    print("increasing integer: ");
    print(integer);
    integer = integer + 1;
}

for (var i = 0; i < 5; i = i + 1) {
    print(i);
    print(" ^_ i");
}

fun printTest(test) {
    print(test);
}


fun sum(a, b) {
    return a + b;
}

print(sum(1, 1));


fun fib(n) {
  if (n < 2) return n;
  return fib(n - 2) + fib(n - 1);
}

var start = clock();
print fib(5);
print clock() - start;


printTest("hello function");

fun outer() {
  var x = "outside";
  fun inner() {
    print x;
  }
  inner();
}
outer();

var globalSet;
var globalGet;

fun main() {
  var a = "initial";

  fun set() { a = "updated"; }
  fun get() { print a; }

  globalSet = set;
  globalGet = get;
}

main();
globalSet();
globalGet();

class CoffeeMaker {
    init(coffee) {
        this.coffee = coffee;
    }

    brew() {
        print "Enjoy your cup of " + this.coffee;
        this.coffee = nil;
    }
}

var maker = CoffeeMaker("coffee and chicory");
print(maker);
maker.brew();


class Doughnut {
  finish(ingredient) {
    print "Finish with " + ingredient;
  }

  cook() {
    print "Dunk in the fryer.";
    this.finish("sprinkles");
  }


}

class Cruller < Doughnut {
  finish(ingredient) {
    super.finish("icing");
  }
}

var crull = Cruller();

crull.cook();

crull.finish("appel");